import serial
import threading

# Adjust this to match your port (Windows: COMx, Linux: /dev/ttyUSB0)
PORT = '/dev/ttyACM1'
BAUDRATE = 115200

ser = serial.Serial(PORT, BAUDRATE, timeout=1)

def read_from_serial():
    while True:
        try:
            line = ser.readline().decode('utf-8', errors='ignore').strip()
            if line:
                print("RAW:", repr(line))
        except Exception as e:
            print("[Error reading serial]", e)

def write_to_serial():
    while True:
        try:
            cmd = input("SEND> ").strip()
            if cmd:
                ser.write((cmd + '\n').encode())
        except Exception as e:
            print("[Error writing to serial]", e)

# Start reader thread
reader_thread = threading.Thread(target=read_from_serial, daemon=True)
reader_thread.start()

# Main thread handles input
write_to_serial()
